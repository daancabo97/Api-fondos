# Copiar a .env y ajustar valores reales.
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env   (Windows)

# Entorno: development | production
# En production se exige SECRET_KEY distinta al default de desarrollo.
ENVIRONMENT=development

# MongoDB
# Dev: standalone local. Prod: URI con replica set, ej.:
# mongodb://user:pass@host1:27017,host2:27017,host3:27017/BTG?replicaSet=rs0
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=BTG

# JWT — OBLIGATORIO cambiar en producción (openssl rand -hex 32)
SECRET_KEY=cambiar-por-clave-segura-en-produccion

# SMTP (Gmail u otro) — necesario para emails reales tras apertura/cancelación
MAIL_USERNAME=correo123@gmail.com
MAIL_PASSWORD=Contraseña123*
MAIL_FROM=correo123*@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# SMS vía Twilio — opcional; sin estas variables SMS se registra en log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=